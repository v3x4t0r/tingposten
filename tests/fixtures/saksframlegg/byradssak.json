  {"page": 1, "x": 381, "y": 187, "size": 9, "text": "[navn]"},
  {"page": 1, "x": 71, "y": 236, "size": 12, "bold": true, "text": "Gjennomføringsvedtak for Slettebakken idrettsby fase 1A"},
  {"page": 1, "x": 71, "y": 262, "bold": true, "text": "Hva saken gjelder:"},
  {"page": 1, "x": 71, "y": 275, "text": "Saken gjelder gjennomføringsvedtak for første del av utviklingen av Slettebakken idrettsby –"},
  {"page": 1, "x": 71, "y": 287.7, "text": "fase 1A. Områdereguleringsplan for Slettebakken er nå vedtatt, jf. bystyresak 172/26."},
  {"page": 1, "x": 71, "y": 313, "text": "Prosjektet omfatter en rekke tiltak:"},
  {"page": 1, "x": 89, "y": 326, "text": "•"},
  {"page": 1, "x": 107, "y": 326, "text": "Ny avkjørsel til Slettebakken borettslag"},
  {"page": 1, "x": 89, "y": 339, "text": "•"},
  {"page": 1, "x": 107, "y": 339, "text": "Planovergang og kryssing av Bybanen,"},
  {"page": 1, "x": 107, "y": 351.7, "text": "inkludert lysregulering"},
  {"page": 1, "x": 89, "y": 364.4, "text": "•"},
  {"page": 1, "x": 107, "y": 364.4, "text": "Snarvei til fysak"},
  {"page": 1, "x": 71, "y": 390, "bold": true, "text": "Økonomiske konsekvenser:"},
  {"page": 1, "x": 71, "y": 403, "text": "Investeringsramme for prosjektet er 69 mill.(P50). Totalkostnad for fase 1 er 352 mill. kroner."},
  {"page": 1, "x": 75, "y": 428, "bold": true, "text": "SUM totalkostnad fase 1"},
  {"page": 1, "x": 433, "y": 428, "bold": true, "text": "352"},
  {"page": 1, "x": 71, "y": 453, "bold": true, "text": "Byrådets vurdering og anbefaling/konklusjon:"},
  {"page": 1, "x": 71, "y": 466, "text": "Byrådet mener prosjektet bør gjennomføres nå, fordi rekkefølgekravene ellers"},
  {"page": 1, "x": 71, "y": 478.7, "text": "stopper byggingen av felleshallene."},
  {"page": 1, "x": 295, "y": 815, "size": 9, "text": "1"},
  {"page": 2, "x": 71, "y": 80, "bold": true, "text": "Begrunnelse for framleggelse til bystyret:"},
  {"page": 2, "x": 71, "y": 93, "text": "Saken legges fram for bystyret fordi investeringen er over 50 mill."},
  {"page": 2, "x": 71, "y": 118, "bold": true, "text": "Byrådet innstiller til bystyret å fatte følgende vedtak:"},
  {"page": 2, "x": 71, "y": 131, "text": "1. Prosjekt 4974 Slettebakken idrettsby - fase 1A gjennomføres med en total"},
  {"page": 2, "x": 71, "y": 143.7, "text": "investeringsramme på 69 mill.(P50)."},
  {"page": 2, "x": 71, "y": 156.4, "text": "2. Prosjektet medfører ingen økte driftskostnader."},
