# The comment server's settings. Copy to debatt.env (gitignored) and fill in.
# Never put the pipeline's keys here (CLAUDE_CODE_OAUTH_TOKEN, STATICHOST_APIKEY …).

# Login e-mails, sent through the freetime.no mail account (Domeneshop).
DEBATT_SMTP_HOST=smtp.domeneshop.no
DEBATT_SMTP_PORT=587
DEBATT_SMTP_BRUKER=
DEBATT_SMTP_PASSORD=
DEBATT_AVSENDER=tingposten@freetime.no

# Only for the moderators chosen in config.DEBATT_MODERATOR:
# Claude API (pay per use; NOT ANTHROPIC_API_KEY, which would make `claude -p` bill the API)
TINGPOSTEN_ANTHROPIC_API_KEY=
# Jev (TypeSafe AI)
TYPESAFE_API_KEY=
