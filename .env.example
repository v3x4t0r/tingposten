# Copy to .env on the Pi. Never commit .env.
#
# The models run through the subscription CLIs (claude -p, codex exec), not API keys.
# Claude Code on a headless Pi: run `claude setup-token` and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# Leave these EMPTY: if set, the CLIs bill the API instead of your subscriptions.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Contact address sent in the User-Agent to Bergen kommune
TINGPOSTEN_CONTACT=
